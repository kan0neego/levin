<?xml version="1.0"?>
<ruleset name="sd-03-2-new">
    <description>Единый стандарт.</description>

    <file>.</file>

    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/blocks/*</exclude-pattern>
    <exclude-pattern>/src/*</exclude-pattern>
    <exclude-pattern>/static/video/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>

    <arg name="tab-width" value="4"/>
    <arg name="extensions" value="php,js,css"/>

    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Universal.WhiteSpace.DisallowInlineTabs"/>
    <rule ref="Generic.WhiteSpace.ScopeIndent"/>

    <rule ref="WordPress.WhiteSpace.ControlStructureSpacing"/>
    <rule ref="WordPress.WhiteSpace.CastStructureSpacing"/>
    <rule ref="WordPress.WhiteSpace.ObjectOperatorSpacing"/>
    <rule ref="WordPress.WhiteSpace.OperatorSpacing"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing"/>
    <rule ref="Generic.Formatting.SpaceAfterCast"/>

    <rule ref="WordPress.Arrays.ArrayIndentation"/>
    <rule ref="WordPress.Arrays.ArrayDeclarationSpacing"/>
    <rule ref="WordPress.Arrays.MultipleStatementAlignment"/>

    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>
    <rule ref="Generic.Files.EndFileNewline"/>

    <rule ref="Internal.NoCodeFound">
        <severity>0</severity>
    </rule>
</ruleset>
